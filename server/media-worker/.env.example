# Copier vers .env pour dev local (ne jamais committer .env rempli).
# Production : variables dans Railway → Settings → Variables.

SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secret partagé avec les Edge Functions Supabase (process-memory, delete-memory-assets).
# Générer une chaîne aléatoire ≥ 32 caractères ; identique dans Supabase → Edge Functions → Secrets.
MEDIA_WORKER_SECRET=

# Port local (Railway injecte PORT automatiquement — ne pas le fixer en prod Railway).
# PORT=8788

# TTL URLs signées écrites en base après dérivés (défaut 30 jours).
# MEDIA_WORKER_SIGNED_URL_SEC=2592000
