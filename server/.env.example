# Copier vers .env pour le dev local (ne jamais committer .env avec des secrets).
# Déploiement : ../DEPLOY.md (hub) · ./DEPLOY_RAILWAY.md · ./DEPLOY_HETZNER.md
# Sur Railway : Settings → Variables (pas besoin de définir PORT, Railway l’injecte).

# ---------------------------------------------------------------------------
# Obligatoires — service PDF principal (`src/index.ts`, workers TS)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Même secret que l’Edge Function `init-export` (JWT HS256, ≥ 32 caractères).
# Sans secret valide, la vérification des tickets export (`generate-pdf`, uploads invité) échoue.
EXPORT_PDF_JWT_SECRET=

# ---------------------------------------------------------------------------
# Optionnel — service PDF
# ---------------------------------------------------------------------------
# Port d’écoute (défaut 8787 si absent). Sur Railway : laisser vide pour utiliser PORT injecté.
# PORT=8787

# Derrière un reverse proxy (Railway, load balancer) : activer pour que rate-limit / IP clients soient corrects.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Optionnel — binaire séparé `server/media-worker` (Node, pas le conteneur Playwright principal)
# Déployer seulement si tu exécutes ce worker comme service à part.
# ---------------------------------------------------------------------------
# MEDIA_WORKER_SECRET=
# (PORT par défaut 8788 pour ce worker si tu le lances localement)
