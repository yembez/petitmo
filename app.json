{
  "expo": {
    "name": "Petitmo",
    "slug": "petitmo",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/c519d009-2310-4101-a27b-8b9e0ed79ffd",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "orientation": "default",
    "icon": "./assets/images/widget_petitmo_gradient.png",
    "scheme": "petitmo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Splash_petitmo_gradient.png",
      "resizeMode": "cover",
      "backgroundColor": "#FD6F9F"
    },
    "locales": {
      "fr": "./locales/fr.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "bundleIdentifier": "com.petitmo.app",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "fr",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Petitmo a besoin d'accéder à ta caméra pour capturer des photos et vidéos de vos moments précieux.",
        "NSMicrophoneUsageDescription": "Petitmo a besoin d'accéder à ton microphone pour enregistrer la voix de ton enfant.",
        "NSPhotoLibraryUsageDescription": "Petitmo a besoin d'accéder à vos photos pour importer des souvenirs existants.",
        "ITSAppUsesNonExemptEncryption": false,
        "EXDefaultScreenOrientationMask": "UIInterfaceOrientationMaskAllButUpsideDown"
      }
    },
    "android": {
      "package": "com.petitmo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/widget_petitmo_gradient.png",
        "backgroundColor": "#FD6F9F"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-screen-orientation",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Petitmo a besoin d'accéder à ta caméra pour capturer des photos et vidéos de vos moments précieux."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Petitmo a besoin d'accéder à ton microphone pour enregistrer la voix de ton enfant."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Petitmo a besoin d'accéder à vos photos pour importer des souvenirs existants."
        }
      ],
      "expo-document-picker",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 10,
            "NSExtensionActivationSupportsMovieWithMaxCount": 1,
            "NSExtensionActivationSupportsFileWithMaxCount": 1
          },
          "iosShareExtensionName": "PetitmoShare",
          "androidIntentFilters": ["image/*", "video/*", "audio/*"],
          "androidMultiIntentFilters": ["image/*", "video/*", "audio/*"]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Petitmo a besoin d'accéder à vos photos pour importer des souvenirs existants."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/Logo_icon_1_transp_2.png",
          "color": "#FD7764",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c519d009-2310-4101-a27b-8b9e0ed79ffd"
      }
    }
  }
}
