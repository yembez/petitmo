{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_PDF_SERVER_URL": "https://petitmo-production.up.railway.app",
        "EXPO_PUBLIC_PUBLIC_MEDIA_BASE_URL": "https://petitmo-production.up.railway.app/m"
      }
    },
    "dev-ios-device": {
      "distribution": "internal",
      "developmentClient": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_PDF_SERVER_URL": "https://petitmo-production.up.railway.app",
        "EXPO_PUBLIC_PUBLIC_MEDIA_BASE_URL": "https://petitmo-production.up.railway.app/m"
      }
    }
  }
}

