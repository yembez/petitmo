# Copier vers scripts/qa/.env.qa (ne jamais committer .env.qa)
#
# Valeurs Railway connues (eas.json) — adapter si ton domaine diffère :
#   PUBLIC_PDF_URL=https://petitmo-production.up.railway.app
#   PUBLIC_MEDIA_BASE_URL=https://petitmo-production.up.railway.app/m

PUBLIC_PDF_URL=
PUBLIC_MEDIA_BASE_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optionnel — smoke-gelato-webhook.sh (même valeur que Railway + Gelato)
# GELATO_WEBHOOK_SECRET=

# Optionnel — check-gelato-export.sh / smoke-gelato-draft.sh (lecture export_requests)
# SUPABASE_SERVICE_ROLE_KEY=

# Email utilisé par init-export (éviter un vrai compte utilisateur)
QA_TEST_EMAIL=qa+petitmo-smoke@example.com

# Optionnel — smoke-gelato-webhook.sh (même valeur que Railway + Gelato)
# GELATO_WEBHOOK_SECRET=
